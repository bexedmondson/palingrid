; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Palingrid"
run/main_scene="uid://28x1mc1dnjtv"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.14901961, 0.2, 0.19607843, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://xof0ydmq2c4x"
config/icon="uid://xof0ydmq2c4x"

[autoload]

CheddaBoards="*res://addons/cheddaboards/CheddaBoards.gd"
Achievements="*res://autoloads/Achievements.gd"
MobileUI="*res://autoloads/MobileUI.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

